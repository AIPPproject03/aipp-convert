# Port server Flask
PORT=5000

# Jalur kustom Tesseract OCR (Opsional - jika tidak terdaftar di PATH)
# Contoh Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Contoh Linux:
# TESSERACT_CMD=/usr/bin/tesseract

# Jalur direktori Poppler bin (Opsional - jika tidak terdaftar di PATH)
# Contoh Windows:
# POPPLER_PATH=C:\poppler\Library\bin
